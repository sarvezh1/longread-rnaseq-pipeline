params {
    help               = false
    input              = null
    outdir             = 'results'

    fasta              = null
    gtf                = null
    genome_build       = null
    annotation_release = null

    mode               = 'default'
    execution_profile  = 'local'

    annotation_guided_alignment = false
    lima_peek_guess            = false
    isoseq_include_singletons  = false
    large_file_publish_mode    = 'link'

    // Portable ceilings applied to every process request.
    max_cpus           = 16
    max_memory         = '64 GB'
    max_time           = '72 h'

    // Block 2 preserves IsoQuant's platform-aware model-construction presets.
    // null leaves the documented data-type-specific single-exon policy intact.
    isoquant_report_novel_unspliced = null
    transcriptome_filtering         = false

    // Block 3 caller-comparison controls. These are analytical configuration,
    // not claims of biological truth.
    flair_min_support                         = 3
    flair_end_window                          = 100
    flair_parallel_mode                       = 'auto:1GB'
    benchmark_end_bins                        = '0,10,25,50'
    benchmark_single_exon_reciprocal_overlap  = 0.5

    // Block 4 biological analysis controls. No differential comparison is
    // inferred: both contrast labels must be explicitly supplied.
    contrast_numerator             = ''
    contrast_denominator           = ''
    block4_design_formula          = '~0 + condition'
    minimum_biological_replicates  = 2
    block4_fdr                     = 0.05
    transcript_end_cluster_window  = 50
    transdecoder_min_peptide_length = 100
    transdecoder_single_best_only   = false
    isoform_switch_min_dif          = 0.1
    enable_functional_enrichment    = false

    // Block 5 reporting. An empty run identifier uses Nextflow's run name.
    report_run_id                   = ''
}

process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
    time     = '4 h'
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
    errorStrategy = 'terminate'

    withLabel: process_single {
        cpus   = 1
        memory = '2 GB'
        time   = '1 h'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '4 GB'
        time   = '4 h'
    }

    withLabel: process_medium {
        cpus   = 4
        memory = '8 GB'
        time   = '12 h'
    }

    withLabel: process_high {
        cpus   = 8
        memory = '32 GB'
        time   = '48 h'
    }
}

timeline {
    enabled = !params.help
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = !params.help
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = !params.help
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = !params.help
    file    = "${params.outdir}/pipeline_info/workflow_dag.html"
}
