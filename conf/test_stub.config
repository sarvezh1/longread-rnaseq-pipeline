includeConfig 'test.config'

params {
    input              = "${projectDir}/tests/data/structural/mixed_valid.csv"
    fasta              = "${projectDir}/tests/data/structural/reference.fa"
    gtf                = "${projectDir}/tests/data/structural/annotation.gtf"
    genome_build       = 'structural-test-build'
    annotation_release = 'structural-test-annotation'
    outdir             = "${projectDir}/tests/results/stub"
    execution_profile  = 'test_stub'
}

