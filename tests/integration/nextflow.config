process {
    // Keep real-fixture tasks serial on small Docker Desktop/WSL test hosts.
    maxForks = 1

    withLabel: process_single {
        cpus = 1
        memory = '1 GB'
    }
    withLabel: process_low {
        cpus = 2
        memory = '2 GB'
    }
    withLabel: process_medium {
        cpus = 2
        memory = '3 GB'
    }
    withLabel: process_high {
        cpus = 2
        memory = '3 GB'
    }
}

report.overwrite = true
timeline.overwrite = true
trace.overwrite = true
dag.overwrite = true
